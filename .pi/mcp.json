{
  "mcpServers": {
    "code-review-graph": {
      "command": "code-review-graph",
      "args": [
        "serve"
      ],
      "exposure": "direct"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "exposure": "direct"
    },
    "task-graph": {
      "command": "~/.local/bin/uv",
      "args": [
        "run",
        "--script",
        ".ai-badger/skills/task-decomposition/scripts/task_graph_server.py"
      ],
      "exposure": "direct"
    }
  }
}
