<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- ValidatorConfiguration uses a ModuleInitializer to set FluentValidation's global
             camelCase property-path resolver — intentional library-side global config. -->
        <NoWarn>$(NoWarn);CA2255</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="CommunityToolkit.Diagnostics"/>
        <PackageReference Include="Polly.Core"/>
        <!-- ADR 0017: TensorPrimitives for EmbeddingMath.MeanPoolAndNormalize. -->
        <PackageReference Include="System.Numerics.Tensors"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiRaccoon.Tests"/>
    </ItemGroup>

</Project>
