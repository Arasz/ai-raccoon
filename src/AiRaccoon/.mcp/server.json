{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
    "description": "Agent memory management over sqlite-memory: project-scoped memory bank, workspace sandboxes, shared promotion tier, hybrid search, degradation, and optional cloud sync.",
    "name": "ai-raccoon/agent-memory",
    "version": "0.1.0-beta",
    "packages": [
        {
            "registryType": "nuget",
            "identifier": "ai-raccoon",
            "version": "0.1.0-beta",
            "transport": {
                "type": "stdio"
            },
            "packageArguments": [],
            "environmentVariables": [
                "AIRACCOON_DATA_ROOT",
                "AIRACCOON_INSTALL_SCOPE",
                "AIRACCOON_ACCESS_MODE",
                "AIRACCOON_OPENAI_API_KEY",
                "AIRACCOON_EMBEDDING_MODEL",
                "AIRACCOON_SYNC_ENDPOINT",
                "AIRACCOON_SYNC_BUCKET",
                "AIRACCOON_SYNC_ACCESS_KEY",
                "AIRACCOON_SYNC_SECRET_KEY",
                "AIRACCOON_SYNC_REGION",
                "AIRACCOON_SYNC_OBJECT_KEY"
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/ai-raccoon/ai-raccoon",
        "source": "github"
    }
}
