<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <PackageType>McpServer</PackageType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageId>ai-raccoon</PackageId>
        <ToolCommandName>ai-raccoon</ToolCommandName>
        <PackageTags>ai mcp mcp-server model-context-protocol agent agents agent-memory memory knowledge knowledge-base server dotnet-tool global-tool tool cli sqlite vector vector-search embeddings semantic-search hybrid-search search retrieval rag llm stdio http dotnet</PackageTags>
        <PackageReleaseNotes>https://github.com/Arasz/ai-raccoon/releases</PackageReleaseNotes>
        <Authors>Rafał Araszkiewicz</Authors>
        <Copyright>Copyright (c) 2026 Rafał Araszkiewicz</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Arasz/ai-raccoon</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Arasz/ai-raccoon</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>An MCP server that gives AI agents persistent, project-scoped memory: a memory bank over sqlite-memory with hybrid vector+BM25 search, workspace sandboxes, a shared promotion tier, and optional S3/Azure sync.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <!-- CopyToOutputDirectory alone puts these under tools/net10.0/<rid>/Models/ — where the packed
         RID tool actually runs from and where BundledModel.ResolveDirectory finds them first. Adding
         Pack="true" PackagePath="Models/…" here also copies them to the package root and into the
         RID-agnostic shim package that nothing reads, tripling the ~97 MB weights across packages.
         The Web SDK's default items separately glob *.json as Content and pack it again under
         content/ and contentFiles/; removing that glob for the bundled model's json files leaves
         the CopyToOutputDirectory copy below as their only one. -->
    <ItemGroup>
        <Content Remove="Models/granite-embedding-small-english-r2/*.json"/>
        <None Include="Models/vocab.txt" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="Models/granite-embedding-small-english-r2/*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Diagnostics"/>
        <PackageReference Include="DotNext"/>
        <PackageReference Include="DotNext.Threading"/>
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="JetBrains.Annotations"/>
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore"/>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
        <PackageReference Include="Polly.Core"/>
        <PackageReference Include="OpenTelemetry"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AiRaccoon.Core/AiRaccoon.Core.csproj"/>
        <ProjectReference Include="../AiRaccoon.Infrastructure/AiRaccoon.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiRaccoon.Tests"/>
    </ItemGroup>

    <!-- server.json's two version slots hold the token __VERSION__; VERSION is the only hand-written
         marker (docs/plans/2026-08-17-search-phase-attribution.md §S4). This substitutes $(Version)
         into a generated copy before the nuspec is built, so the packed manifest (not just the repo
         copy) carries the real version. -->
    <!-- The bundled model's weights are fetched, not committed: a pack without them would ship a
         tool whose default engine cannot load (ADR-0108). -->
    <Target Name="RequireBundledModelWeights" BeforeTargets="_GetPackageFiles">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/Models/granite-embedding-small-english-r2/model_fp16.onnx_data')"
               Text="The bundled embedding model's weights (Models/granite-embedding-small-english-r2/model_fp16.onnx_data) are missing, so this package could not load its default engine. Run 'python3 scripts/download-embedding-model.py' first."/>
    </Target>

    <Target Name="GenerateMcpServerJson" BeforeTargets="_GetPackageFiles">
        <PropertyGroup>
            <_McpServerJsonSource>$(MSBuildProjectDirectory)\.mcp\server.json</_McpServerJsonSource>
            <_McpServerJsonGenerated>$(IntermediateOutputPath)mcp\server.json</_McpServerJsonGenerated>
        </PropertyGroup>
        <ReadLinesFromFile File="$(_McpServerJsonSource)">
            <Output TaskParameter="Lines" ItemName="_McpServerJsonLine"/>
        </ReadLinesFromFile>
        <MakeDir Directories="$(IntermediateOutputPath)mcp"/>
        <WriteLinesToFile File="$(_McpServerJsonGenerated)" Overwrite="true"
                          Lines="@(_McpServerJsonLine->Replace('__VERSION__', '$(Version)'))"/>
        <ItemGroup>
            <None Include="$(_McpServerJsonGenerated)" Pack="true" PackagePath="/.mcp/"/>
        </ItemGroup>
    </Target>

    <Target Name="DeployToLocalSource" AfterTargets="Build"
            Condition="'$(DOTNET_ENV)' == 'local' and '$(SuppressDeployToLocalSource)' != 'true'"
            Inputs="$(MSBuildProjectFullPath);$(TargetPath)"
            Outputs="$(PackageOutputPath)$(PackageId).$(NETCoreSdkRuntimeIdentifier).$(PackageVersion).nupkg">
        <MakeDir Directories="$(MSBuildThisFileDirectory)../../.nupkg-local/"/>
        <Exec Command="dotnet pack &quot;$(MSBuildProjectFullPath)&quot; -c &quot;$(Configuration)&quot; -p:RuntimeIdentifiers=$(NETCoreSdkRuntimeIdentifier) -p:SuppressDeployToLocalSource=true -o &quot;$(PackageOutputPath)&quot;"/>
        <Exec Command="dotnet nuget push &quot;$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg&quot; --source &quot;$(MSBuildThisFileDirectory)../../.nupkg-local&quot; --skip-duplicate"/>
        <Exec Command="dotnet nuget push &quot;$(PackageOutputPath)$(PackageId).$(NETCoreSdkRuntimeIdentifier).$(PackageVersion).nupkg&quot; --source &quot;$(MSBuildThisFileDirectory)../../.nupkg-local&quot; --skip-duplicate"/>
    </Target>

</Project>
