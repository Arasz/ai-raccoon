<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <PackageType>McpServer</PackageType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageId>ai-raccoon</PackageId>
        <PackageVersion>0.1.0-beta</PackageVersion>
        <PackageTags>AI; MCP; server; stdio; http; sqlite; agent; memory; vector; rag</PackageTags>
        <Description>An MCP server that will expose memory API for your agent</Description>
    </PropertyGroup>

    <!-- Self-contained single-file publishing lives in Properties/PublishProfiles/
         so the project stays referenceable from the test project (NETSDK1151). -->

    <ItemGroup>
        <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/"/>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AiRaccoon.Core/AiRaccoon.Core.csproj"/>
        <ProjectReference Include="../AiRaccoon.Infrastructure/AiRaccoon.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiRaccoon.Tests"/>
    </ItemGroup>

    <!-- Deploy the freshly built package to the local NuGet feed (.nupkg-local/)
         when running in a local dev environment. The gate is the dotnet_env
         environment variable (lowercase), set only for this directory:
         export dotnet_env=local   (or direnv: "dotnet_env=local" in .envrc)
         PackAsTool with a RuntimeIdentifier emits a tool shell plus a RID
         payload package; both must be pushed or `dotnet tool install` fails. -->
    <Target Name="DeployToLocalSource" AfterTargets="Build"
            Condition="'$(DOTNET_ENV)' == 'local'"
            Inputs="$(MSBuildProjectFullPath);$(TargetPath)"
            Outputs="$(PackageOutputPath)$(PackageId).$(NETCoreSdkRuntimeIdentifier).$(PackageVersion).nupkg">
        <MakeDir Directories="$(MSBuildThisFileDirectory)../../.nupkg-local/"/>
        <!-- Pack only for the host RID: the project's multi-RID RuntimeIdentifiers
             list would otherwise force a full per-RID publish during pack. -->
        <Exec Command="dotnet pack &quot;$(MSBuildProjectFullPath)&quot; -c &quot;$(Configuration)&quot; -p:RuntimeIdentifiers=$(NETCoreSdkRuntimeIdentifier) -o &quot;$(PackageOutputPath)&quot; --no-build --no-restore"/>
        <Exec Command="dotnet nuget push &quot;$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg&quot; --source &quot;$(MSBuildThisFileDirectory)../../.nupkg-local&quot; --skip-duplicate"/>
        <Exec Command="dotnet nuget push &quot;$(PackageOutputPath)$(PackageId).$(NETCoreSdkRuntimeIdentifier).$(PackageVersion).nupkg&quot; --source &quot;$(MSBuildThisFileDirectory)../../.nupkg-local&quot; --skip-duplicate"/>
    </Target>

</Project>
