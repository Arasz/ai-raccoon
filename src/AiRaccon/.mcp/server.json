{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
    "description": "Agent memory management over sqlite-memory: project-scoped memory bank, workspace sandboxes, shared promotion tier, hybrid search, degradation, and optional cloud sync.",
    "name": "ai-raccon/agent-memory",
    "version": "0.1.0-beta",
    "packages": [
        {
            "registryType": "nuget",
            "identifier": "ai-raccon",
            "version": "0.1.0-beta",
            "transport": {
                "type": "stdio"
            },
            "packageArguments": [],
            "environmentVariables": [
                "AIRACCON_DATA_ROOT",
                "AIRACCON_INSTALL_SCOPE",
                "AIRACCON_SQLITECLOUD_DB_ID",
                "AIRACCON_SQLITECLOUD_API_KEY",
                "AIRACCON_VECTORSSPACE_API_KEY"
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/ai-raccon/ai-raccon",
        "source": "github"
    }
}
