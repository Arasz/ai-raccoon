<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AiRaccoon.Infrastructure/AiRaccoon.Infrastructure.csproj"/>
    </ItemGroup>

    <!-- Same bundled-model copy contract as src/AiRaccoon: the int8 ONNX model + BERT vocab
         land next to the tool so BundledModel.ResolveModelPath finds them. -->
    <ItemGroup>
        <None Include="../../src/AiRaccoon/Models/vocab.txt" Link="Models/vocab.txt" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../../src/AiRaccoon/Models/*.onnx" Link="Models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
