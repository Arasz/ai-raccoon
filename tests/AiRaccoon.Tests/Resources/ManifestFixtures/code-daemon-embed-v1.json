{
  "manifestVersion": 1,
  "model": "faxenoff/code-daemon-embed-v1",
  "source": { "repo": "faxenoff/code-daemon-embed-v1", "revision": "main" },
  "provider": "local",
  "dimensions": 768,
  "contextWindowTokens": 128,
  "normalization": "l2",
  "requiresTokenTypeIds": false,
  "pooling": {
    "mode": "model-output"
  },
  "tokenizer": {
    "family": "sentencepiece",
    "files": [
      { "path": "sentencepiece.bpe.model", "sha256": "5f97e3774c51edd1d63706c2ec3826c564a067794770cdab0f8c4797971cacf9" }
    ],
    "options": {
      "addBeginOfSentence": true,
      "addEndOfSentence": true,
      "specialTokens": { "<s>": 2, "</s>": 3, "<pad>": 0, "<unk>": 1 }
    }
  },
  "onnx": {
    "inputs": [ "input_ids", "attention_mask" ],
    "embeddingOutput": "sentence_embedding",
    "files": [
      { "path": "model.onnx", "sha256": "9372c470eeadd5ecd9c3c74c2b3cb633f8e2f2fad799250a0f70d652b6b825e4" }
    ]
  }
}
