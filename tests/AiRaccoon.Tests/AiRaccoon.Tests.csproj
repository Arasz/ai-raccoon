<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!-- WebApplicationFactory-based E2E tests need the ASP.NET Core shared framework. -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="ModelContextProtocol.Core"/>
        <PackageReference Include="Reqnroll.xunit.v3"/>
        <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" PrivateAssets="all"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AiRaccoon/AiRaccoon.csproj"/>
        <ProjectReference Include="../../src/AiRaccoon.Core/AiRaccoon.Core.csproj"/>
        <ProjectReference Include="../../src/AiRaccoon.Infrastructure/AiRaccoon.Infrastructure.csproj"/>
    </ItemGroup>

    <!-- Golden-retrieval harness: reuse the benchmark corpus (data-only C#
         files, no benchmark packages) and copy the committed asset manifest. -->
    <ItemGroup>
        <Compile Include="../../benchmarks/AiRaccoon.Benchmarks/Corpus/CorpusModels.cs" Link="Corpus/CorpusModels.cs"/>
        <Compile Include="../../benchmarks/AiRaccoon.Benchmarks/Corpus/RealWorldCorpus.cs" Link="Corpus/RealWorldCorpus.cs"/>
        <Compile Include="../../benchmarks/AiRaccoon.Benchmarks/Corpus/RealWorldQueries.cs" Link="Corpus/RealWorldQueries.cs"/>
        <Compile Include="..\..\docs\work\features-agent-memory\agent-memory.feature.cs">
          <Link>bdd\features-agent-memory\agent-memory.feature.cs</Link>
        </Compile>
        <Compile Include="..\..\docs\work\features-native-memory\native-memory.feature.cs">
          <Link>bdd\features-native-memory\native-memory.feature.cs</Link>
        </Compile>
        <Content Include="unit/retrieval/assets/manifest.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Reqnroll generated-test suite: feature files from docs/work/. -->
    <ItemGroup>
        <ReqnrollFeatureFiles Include="..\..\docs\work\features-agent-memory\agent-memory.feature">
          <Link>bdd\features-agent-memory\agent-memory.feature</Link>
        </ReqnrollFeatureFiles>
        <ReqnrollFeatureFiles Include="..\..\docs\work\features-native-memory\native-memory.feature">
          <Link>bdd\features-native-memory\native-memory.feature</Link>
        </ReqnrollFeatureFiles>
    </ItemGroup>
    <ItemGroup>
      <ReqnrollFeatureFile Include="..\..\docs\work\features-agent-memory\agent-memory.feature">
        <Link>bdd\features-agent-memory\agent-memory.feature</Link>
      </ReqnrollFeatureFile>
      <ReqnrollFeatureFile Include="..\..\docs\work\features-native-memory\native-memory.feature">
        <Link>bdd\features-native-memory\native-memory.feature</Link>
      </ReqnrollFeatureFile>
    </ItemGroup>

</Project>
