<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="ModelContextProtocol.Core"/>
        <PackageReference Include="NSubstitute"/>
        <PackageReference Include="OpenTelemetry.Exporter.InMemory"/>
        <PackageReference Include="Reqnroll.xunit.v3"/>
        <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" PrivateAssets="all"/>
        <PackageReference Include="TngTech.ArchUnitNET.xUnitV3"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"/>
        <PackageReference Include="xRetry.v3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AiRaccoon/AiRaccoon.csproj"/>
        <ProjectReference Include="../../src/AiRaccoon.Core/AiRaccoon.Core.csproj"/>
        <ProjectReference Include="../../src/AiRaccoon.Infrastructure/AiRaccoon.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- WP1 golden fixtures (D1 schema pins): the malformed set carries exactly one defect per file. -->
        <Content Include="Resources\ManifestFixtures\**\*.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Unit\Retrieval\assets\manifest.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources/docs-memory.db" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="Resources/gate-query-vectors.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ReqnrollFeatureFiles Include="..\..\docs\work\features-agent-memory\agent-memory.feature">
            <Link>BDD\features-agent-memory\agent-memory.feature</Link>
        </ReqnrollFeatureFiles>
        <ReqnrollFeatureFiles Include="..\..\docs\work\features-native-memory\native-memory.feature">
            <Link>BDD\features-native-memory\native-memory.feature</Link>
        </ReqnrollFeatureFiles>
        <ReqnrollFeatureFiles Include="..\..\docs\features\file-watcher\file-watcher.feature">
            <Link>BDD\features-file-watcher\file-watcher.feature</Link>
        </ReqnrollFeatureFiles>
        <ReqnrollFeatureFiles Include="..\..\docs\features\encryption-bitwarden\encryption-bitwarden.feature">
            <Link>BDD\features-encryption-bitwarden\encryption-bitwarden.feature</Link>
        </ReqnrollFeatureFiles>
        <ReqnrollFeatureFiles Include="..\..\docs\features\code-corpus\code-corpus.feature">
            <Link>BDD\features-code-corpus\code-corpus.feature</Link>
        </ReqnrollFeatureFiles>
        <ReqnrollFeatureFiles Include="..\..\docs\work\features-single-project-id\single-project-id.feature">
            <Link>BDD\features-single-project-id\single-project-id.feature</Link>
        </ReqnrollFeatureFiles>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\benchmarks\AiRaccoon.Benchmarks\Corpus\CorpusModels.cs">
            <Link>Unit\Retrieval\Corpus\CorpusModels.cs</Link>
        </Compile>
        <Compile Include="..\..\benchmarks\AiRaccoon.Benchmarks\Corpus\RealWorldCorpus.cs">
            <Link>Unit\Retrieval\Corpus\RealWorldCorpus.cs</Link>
        </Compile>
        <Compile Include="..\..\benchmarks\AiRaccoon.Benchmarks\Corpus\RealWorldQueries.cs">
            <Link>Unit\Retrieval\Corpus\RealWorldQueries.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
