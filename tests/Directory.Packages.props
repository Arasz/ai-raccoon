<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup Label="Testing">
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0"/>
        <PackageVersion Include="NSubstitute" Version="6.2.0"/>
        <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0"/>
        <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4"/>
        <PackageVersion Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4"/>
        <PackageVersion Include="xunit.v3" Version="4.0.2"/>
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
        <PackageVersion Include="xRetry.v3" Version="1.0.0"/>
    </ItemGroup>
</Project>
