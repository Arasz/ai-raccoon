# Golden-retrieval harness reference binaries (pinned by manifest.json; the bootstrap copies
# verified copies from ~/.ai-raccoon or downloads the pinned releases). Committed inside the
# directory: manifest.json, reference-topk.json and the asset-policy sources.
tests/AiRaccoon.Tests/Retrieval/assets/*
!tests/AiRaccoon.Tests/Retrieval/assets/manifest.json
!tests/AiRaccoon.Tests/Retrieval/assets/reference-topk.json
!tests/AiRaccoon.Tests/Retrieval/assets/ReferenceAssets.cs
!tests/AiRaccoon.Tests/Retrieval/assets/ReferenceAssetGateTests.cs
# Bundled ONNX embedding model (FR-NM-3): downloaded + SHA-pinned by scripts/download-embedding-model.sh.
# vocab.txt is committed; only the ~23 MB binary is gitignored.
src/AiRaccoon/Models/*.onnx
# Reqnroll generated code-behind files (P12)
**/*.feature.cs
baseline-results.json
scripts/baseline-results.json
# SQLite WAL sidecars (journal_mode=WAL is forced by SqliteConnectionFactory)
*.db-shm
*.db-wal
