bin/
obj/
/packages/
/.nupkg/
/.nupkg-local/

/.ai-badger/worktrees/
/.ai-badger/task-tracking/
/.ai-badger/prompt-markers/
/.ai-badger.bckp/
# Per-session learned-skill artifacts (auto-scaffolded by agents; regenerated, not versioned)
.ai-badger/skills-data/hermes/learned.json
.ai-badger/skills/learned/*

/.claude/worktrees/

riderModule.iml
/_ReSharper.Caches/
.DS_Store
__pycache__/
/BenchmarkDotNet.Artifacts/
# Golden-retrieval harness reference binaries (pinned by manifest.json; the bootstrap copies
# verified copies from ~/.ai-raccoon or downloads the pinned releases). Committed inside the
# directory: manifest.json and reference-topk.json.
tests/AiRaccoon.Tests/Unit/Retrieval/assets/*
!tests/AiRaccoon.Tests/Unit/Retrieval/assets/manifest.json
!tests/AiRaccoon.Tests/Unit/Retrieval/assets/reference-topk.json
# Reqnroll generated code-behind files (P12)
**/*.feature.cs
# trx test results + E2E serve-log diagnostics written by scripts/nightly-triage.py
# (the trx logger writes under the test project dir when given a relative path, so **)
**/TestResults/
/dumps/
# SQLite WAL sidecars (journal_mode=WAL is forced by SqliteConnectionFactory)
*.db-shm
*.db-wal

# Removed at ai-raccoon#414: a bank built from the private job-search-ai-assistant tree must
# never come back. NOT `*.db` — the public replacement docs-memory.db is committed on purpose,
# and a blanket ignore would silently drop it. Paired with a gate, because a .gitignore line is
# not one: tests/.../Unit/Retrieval/CorpusFixtureGuardTests.cs fails if this file reappears.
tests/AiRaccoon.Tests/Resources/jsaa-memory.db
# Owner-local regenerated banks (never committed).
tests/AiRaccoon.Tests/Resources/*-local.db

# Generated by ParityGateTests; regenerate by running the parity gate.
tests/AiRaccoon.Tests/Unit/Retrieval/Managed/

# Rider per-user IDE state (decompiled-source inclusions, unit-test sessions) — machine-specific.
*.DotSettings.user

# Backup files
*.bak-*
*.bak

# Generated logs (semantica, serve.log, quiet.log, etc.)
*.log

# Semantica graph dumps: local staging only — the durable record lives in ai-raccoon memory
.semantica/

# Stray tool artifact, committed once by accident in 11df8313 (0 bytes).
identifier.sqlite

# Profiler output. Rider's dotTrace/dotMemory default to writing here, and a single
# sampling snapshot of `ai-raccoon serve` is ~15 MB — the extensions are listed as well
# because the save dialog remembers wherever you last pointed it.
tmp/
*.dtp
*.dmw
*.nettrace
*.gcdump

# BEGIN ai-badger managed block — do not edit; regenerated by welcome-ai-badger
.ai-badger/task-tracking/tracking.db
.ai-badger/task-tracking/*.db-wal
.ai-badger/task-tracking/*.db-shm
# END ai-badger managed block
