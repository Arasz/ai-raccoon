+
+    // PoC ONLY: resolves the post-fusion diversifier from env, or null when off. Off when the
+    // sidecar vectors are absent (the store skipped its fetch), when MMR_DISABLE is set, when
+    // MMR_MODE is off/unknown, and for path queries (mirrors SourceLambdaFor). The scalar
+    // overload never diversifies, so it stays unit-test pure. One stderr line per Merge call
+    // when active. NOT SHIPPABLE.
+    private static Func<IReadOnlyList<MemorySearchResult>, IReadOnlyList<MemorySearchResult>>? PocDiversifierFor(
+        FtsQueryPlan queryPlan,
+        IReadOnlyDictionary<string, float[]>? pocVectors)
+    {
+        if (pocVectors is null)
+        {
+            return null;
+        }
+
+        if (queryPlan.IsPathQuery)
+        {
+            return null;
+        }
+
+        if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("MMR_DISABLE")))
+        {
+            return null;
+        }
+
+        var mode = (Environment.GetEnvironmentVariable("MMR_MODE") ?? "mmr").ToLowerInvariant();
+        if (mode is not ("mmr" or "threshold"))
+        {
+            return null;
+        }
+
+        var rho = PocDouble("MMR_RHO", 0.1, nonNegative: true);
+        var tau = PocDouble("MMR_TAU", 0.95, nonNegative: false);
+        return ranked =>
+        {
+            double Sim(string a, string b)
+            {
+                if (pocVectors.TryGetValue(a, out var va) && pocVectors.TryGetValue(b, out var vb))
+                {
+                    return MaximalMarginalRelevance.Cosine(va, vb);
+                }
+
+                return 0.0;
+            }
+
+            var diversified = mode == "threshold"
+                ? MaximalMarginalRelevance.ThresholdFilter(ranked, tau, Sim)
+                : MaximalMarginalRelevance.Rerank(ranked, rho, Sim);
+            Console.Error.WriteLine($"[mmr-poc] mode={mode} rho={rho.ToString(System.Globalization.CultureInfo.InvariantCulture)} tau={tau.ToString(System.Globalization.CultureInfo.InvariantCulture)} pool={ranked.Count} fetched={pocVectors.Count}");
+            return diversified;
+        };
+    }
+
+    // PoC ONLY: env double with a hardcoded default; unparseable (or negative when
+    // nonNegative) falls back to the default. Invariant culture, like the prior leg-level PoC.
+    private static double PocDouble(string name, double fallback, bool nonNegative)
+    {
+        var raw = Environment.GetEnvironmentVariable(name);
+        if (raw is not null && double.TryParse(raw, System.Globalization.NumberStyles.Float,
+                System.Globalization.CultureInfo.InvariantCulture, out var parsed) && (!nonNegative || parsed >= 0))
+        {
+            return parsed;
+        }
+
+        return fallback;
+    }
 }
