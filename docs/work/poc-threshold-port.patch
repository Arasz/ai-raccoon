+        MergeCore(searchResults, limit, minRelativeScore, rrfK, sourceLambda, consolidationThreshold, formula, null);
+
+    private static IReadOnlyList<MemorySearchResult> MergeCore(
+        IReadOnlyList<MemorySearchResult> searchResults,
+        int limit,
+        double minRelativeScore,
+        int rrfK,
+        double sourceLambda,
+        double consolidationThreshold,
+        DocScoreFormula formula,
+        Func<IReadOnlyList<MemorySearchResult>, IReadOnlyList<MemorySearchResult>>? diversify)
     {
         var unitWeightResults = new WeightedResults(searchResults, 1.0);
         var fused = ReciprocalRankFusion.Fuse([unitWeightResults], rrfK, 0.0, int.MaxValue);
         var ranked = SourceAffinityRanker.Rank(fused, sourceLambda, consolidationThreshold, formula);
