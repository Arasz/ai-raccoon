+++ b/src/AiRaccoon.Infrastructure/Sqlite/Memory/MaximalMarginalRelevance.cs
@@ -0,0 +1,110 @@
+using AiRaccoon.Core.Memory;
+
+namespace AiRaccoon.Infrastructure.Sqlite.Memory;
+
+/// <summary>
+///     PoC ONLY (branch task/air-mmr-postfusion-poc): post-fusion diversifiers, applied inside
+///     SearchResultMerger.Merge between SourceAffinityRanker.Rank and the floor/limit. Pure and
+///     order-only (the threshold filter drops near-dupes but never reorders), scores untouched.
+///     Rerank's dial is the additive penalty rho: pick = argmax(rel - rho * maxSimToPicked);
+///     rho = 0 is identity. ThresholdFilter's dial is the near-dupe cosine ceiling tau: a row is
+///     dropped when its cosine to ANY already-kept row exceeds tau. Missing vectors score
+///     similarity 0.0 (never reorder or drop on ignorance). NOT SHIPPABLE: hardcoded defaults,
+///     env-gated, no settings plumbing, no tests.
+/// </summary>
+internal static class MaximalMarginalRelevance
+{
+    public static IReadOnlyList<MemorySearchResult> Rerank(
+        IReadOnlyList<MemorySearchResult> candidates,
+        double rho,
+        Func<string, string, double> similarity)
+    {
+        if (rho <= 0 || candidates.Count <= 1)
+        {
+            return candidates;
+        }
+
+        var remaining = new List<MemorySearchResult>(candidates);
+        var selected = new List<MemorySearchResult>(candidates.Count);
+        while (remaining.Count > 0)
+        {
+            MemorySearchResult? best = null;
+            var bestScore = double.NegativeInfinity;
+            foreach (var candidate in remaining)
+            {
+                var penalty = 0.0;
+                foreach (var picked in selected)
+                {
+                    var sim = similarity(candidate.Hash, picked.Hash);
+                    if (sim > penalty)
+                    {
+                        penalty = sim;
+                    }
+                }
+
+                var score = candidate.Ranking - rho * penalty;
+                // Deterministic: strictly-greater keeps incoming (relevance) order on ties.
+                if (score > bestScore)
+                {
+                    bestScore = score;
+                    best = candidate;
+                }
+            }
+
+            selected.Add(best!);
+            remaining.Remove(best!);
+        }
+
+        return selected;
+    }
+
+    public static IReadOnlyList<MemorySearchResult> ThresholdFilter(
+        IReadOnlyList<MemorySearchResult> candidates,
+        double tau,
+        Func<string, string, double> similarity)
+    {
+        if (candidates.Count <= 1)
+        {
+            return candidates;
+        }
+
+        var kept = new List<MemorySearchResult>(candidates.Count);
+        foreach (var candidate in candidates)
+        {
+            var isNearDupe = false;
+            foreach (var prior in kept)
+            {
+                if (similarity(candidate.Hash, prior.Hash) > tau)
+                {
+                    isNearDupe = true;
+                    break;
+                }
+            }
+
+            if (!isNearDupe)
+            {
+                kept.Add(candidate);
+            }
+        }
+
+        return kept;
+    }
+
+    public static double Cosine(float[] a, float[] b)
+    {
+        if (a.Length != b.Length || a.Length == 0)
+        {
+            return 0.0;
+        }
+
+        double dot = 0, na = 0, nb = 0;
+        for (var i = 0; i < a.Length; i++)
+        {
+            dot += (double)a[i] * b[i];
+            na += (double)a[i] * a[i];
+            nb += (double)b[i] * b[i];
+        }
+
+        return na <= 0 || nb <= 0 ? 0.0 : dot / (Math.Sqrt(na) * Math.Sqrt(nb));
+    }
+}
