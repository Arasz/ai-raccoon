# ai-raccoon.ignore — paths the memory and code corpora skip on ingest and watch (ADR-0086).
# Hidden directories and the built-in deny set (bin, obj, node_modules, .git, .venv,
# __pycache__, dist, build, target) are skipped already; this lists what is left.

# Checklist evidence: large JSON transcripts of command output; the checklist skill reads them from disk.
docs/work/checklist/

# Test fixtures: golden JSON sets, a sample bank, model assets.
tests/AiRaccoon.Tests/Resources/
tests/AiRaccoon.Tests/Unit/Retrieval/assets/

# Bundled model binaries.
src/AiRaccoon/Models/

# Generated code and CI bookkeeping.
*.g.cs
known-flakes.json

# Mitigation for #494 until the watch filters events itself: hidden directories and the
# enumeration deny set, so a file written under them after registration is never digested
# and the re-scan this edit triggers prunes what already leaked (agent worktrees under
# .claude/worktrees and .ai-badger/worktrees included).
.*/
node_modules/
bin/
obj/
dist/
build/
target/
__pycache__/
